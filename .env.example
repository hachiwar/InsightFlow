# Public endpoint. Use :80 for IP-based testing, or api.example.com for automatic HTTPS.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# Public API authentication. Replace both example values before deployment.
ECHOMIND_API_KEY=replace-with-a-long-random-public-api-key
ASKDATA_API_KEY=replace-with-a-different-long-random-internal-api-key

# Redis authentication. Replace this value before deployment.
REDIS_PASSWORD=replace-with-a-long-random-redis-password

# EchoMind model. Configure exactly one active profile and its API key.
SPRING_PROFILES_ACTIVE=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5
LLM_FALLBACK_ENABLED=false

# AskData model. Keep mock disabled for any public deployment.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
ASKDATA_ALLOW_MOCK=false
ASKDATA_TIMEOUT_MS=30000
ASKDATA_MAX_REQUEST_BYTES=65536

# Optional JVM tuning for the Java container.
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
