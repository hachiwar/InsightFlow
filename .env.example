# Public endpoint. Use :80 for IP-based testing, or api.example.com for automatic HTTPS.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# API authentication. Replace all example values before deployment.
MINDAGENT_API_KEY=replace-with-a-long-random-public-api-key
MINDAGENT_ADMIN_API_KEY=replace-with-a-different-long-random-admin-api-key
MINDAGENT_PRINCIPAL_ID=insightflow-client
DATAAGENT_API_KEY=replace-with-a-different-long-random-internal-api-key

# Redis authentication. Replace this value before deployment.
REDIS_PASSWORD=replace-with-a-long-random-redis-password

# MindAgent model. Configure exactly one active profile and its API key.
SPRING_PROFILES_ACTIVE=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5
LLM_FALLBACK_ENABLED=false

# DataAgent model. Keep mock disabled for any public deployment.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_CHAT_URL=
DASHSCOPE_EMBEDDING_URL=
DASHSCOPE_RERANK_URL=
DATAAGENT_ALLOW_MOCK=false
DATAAGENT_INITIALIZE_DEMO=true
DATAAGENT_DATABASE_NAME=trade_db
DATAAGENT_DB_PATH=/app/runtime_data/trade_demo.db
DATAAGENT_BUSINESS_META_PATH=
DATAAGENT_ALLOWED_TABLES=trade_summary,interest_info
DATAAGENT_MILVUS_URI=/app/runtime_data/schema_index.db
DATAAGENT_MILVUS_TOKEN=
DATAAGENT_TIMEOUT_MS=30000
DATAAGENT_MAX_REQUEST_BYTES=65536

# Optional JVM tuning for the Java container.
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
